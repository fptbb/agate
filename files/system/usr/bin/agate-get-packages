#!/bin/bash

# argument: all (default), host, distrobox
MODE="${1:-all}"

# paths - using /var/lib/agate for persistent state data
# Note: Directory permissions are managed via /usr/lib/tmpfiles.d/agate.conf
CACHE_FILE="/var/lib/agate/package-counts.json"

# Load image index (prefer the copy generated at build time).
if [[ -f /usr/share/agate/malachite.json ]] && jq -e '.images | type == "object"' /usr/share/agate/malachite.json >/dev/null 2>&1; then
    IMG_JSON=$(cat /usr/share/agate/malachite.json)
else
    IMG_JSON=$(curl -fsSL https://malachite.fpt.icu/images.json 2>/dev/null || echo '{"images":{}}')
fi

# Image ids and their package managers.
IMAGE_IDS=$(echo "$IMG_JSON" | jq -r '.images | keys[]' 2>/dev/null)
declare -A IMG_MANAGER
for id in $IMAGE_IDS; do
    IMG_MANAGER[$id]=$(echo "$IMG_JSON" | jq -r --arg id "$id" '.images[$id].manager')
done

# ensure cache exists with defaults
if [[ ! -f "$CACHE_FILE" ]]; then
    if [[ -w "$(dirname "$CACHE_FILE")" ]]; then
        echo '{}' > "$CACHE_FILE" 2>/dev/null || true
    fi
fi

# use a temporary directory for parallel results
TMP_DIR=$(mktemp -d)
trap 'rm -rf "$TMP_DIR"' EXIT

# 1. AppImage count (Background)
(
    appimg=$(fp-appimage-updater list --json 2>/dev/null | jq '.apps | map(select(.local_version != null)) | length' 2>/dev/null)
    echo "${appimg:-0}" > "$TMP_DIR/appimg"
) &

# 2. Get Podman containers status once (Background)
(
    podman ps -a --filter "label=manager=distrobox" --format '{{.Names}}|{{.Status}}' 2>/dev/null > "$TMP_DIR/containers"
) &

# 3. Fastfetch (Background)
(
    command fastfetch -c none -s packages --format json 2>/dev/null > "$TMP_DIR/fastfetch"
) &

# Wait for container list and fastfetch to be ready
wait $! 2>/dev/null

# Load last known counts from cache.
declare -A CACHED_COUNT
for id in $IMAGE_IDS; do
    CACHED_COUNT[$id]=$(jq -r --arg id "$id" '.[$id] // 0' "$CACHE_FILE" 2>/dev/null || echo 0)
done

# Process containers.
if [[ -f "$TMP_DIR/containers" ]]; then
    for id in $IMAGE_IDS; do
        status=$(grep "^${id}|" "$TMP_DIR/containers" 2>/dev/null | head -1 | cut -d'|' -f2)
        if [[ -n "$status" ]]; then
            if [[ "$status" == Up* ]]; then
                manager="${IMG_MANAGER[$id]}"
                (
                    case "$manager" in
                        apk)
                            count=$(podman exec "$id" apk info 2>/dev/null | wc -l)
                            ;;
                        apt)
                            count=$(podman exec "$id" sh -c "dpkg -l 2>/dev/null | grep -c '^ii'" 2>/dev/null)
                            ;;
                        *)
                            count=$(podman exec "$id" rpm -qa 2>/dev/null | wc -l)
                            ;;
                    esac
                    echo "${count:-0}" > "$TMP_DIR/count_$id"
                ) &
            else
                echo "${CACHED_COUNT[$id]:-0}" > "$TMP_DIR/count_$id"
            fi
        else
            echo "${CACHED_COUNT[$id]:-0}" > "$TMP_DIR/count_$id"
        fi
    done
fi

# Wait for everything
wait

# Collect results
appimg=$(cat "$TMP_DIR/appimg" 2>/dev/null || echo 0)
fastfetch_json=$(cat "$TMP_DIR/fastfetch" 2>/dev/null || echo "[]")

declare -A COUNTS
for id in $IMAGE_IDS; do
    COUNTS[$id]=$(cat "$TMP_DIR/count_$id" 2>/dev/null || echo "${CACHED_COUNT[$id]:-0}")
    # fallback if file missing
    [[ -z "${COUNTS[$id]}" ]] && COUNTS[$id]="${CACHED_COUNT[$id]:-0}"
done

# Update cache if any count changed and is valid (>0)
if [[ -w "$(dirname "$CACHE_FILE")" ]]; then
    cache_json='{}'
    updated=0
    for id in $IMAGE_IDS; do
        count="${COUNTS[$id]:-0}"
        last="${CACHED_COUNT[$id]:-0}"
        if [[ "$count" -gt 0 ]]; then
            new="$count"
            updated=1
        else
            new="$last"
        fi
        cache_json=$(echo "$cache_json" | jq --arg id "$id" --argjson c "$new" '.[$id]=$c')
    done
    if [[ "$updated" -eq 1 ]]; then
        echo "$cache_json" > "$CACHE_FILE.tmp" 2>/dev/null && mv "$CACHE_FILE.tmp" "$CACHE_FILE" 2>/dev/null || true
    fi
fi

# Parse fastfetch host packages.
read -r nix brew flatpak < <(echo "$fastfetch_json" | jq -r '
  (.[0].result // {}) as $r |
  [($r.nixUser // 0)+($r.nixDefault // 0)+($r.nix // 0),
   ($r.brew // 0)+($r.brewCask // 0),
   ($r.flatpakSystem // 0)+($r.flatpakUser // 0)+($r.flatpak // 0)] | @tsv
' 2>/dev/null)
nix=${nix:-0}; brew=${brew:-0}; flatpak=${flatpak:-0}

# Build output.
parts=()
if [[ "$MODE" == "all" || "$MODE" == "host" ]]; then
    [[ "$nix" -gt 0 ]] && parts+=("$nix (nix)")
    [[ "$brew" -gt 0 ]] && parts+=("$brew (brew)")
    [[ "$flatpak" -gt 0 ]] && parts+=("$flatpak (ftpk)")
    [[ "$appimg" -gt 0 ]] && parts+=("$appimg (appimg)")
fi
if [[ "$MODE" == "all" || "$MODE" == "distrobox" ]]; then
    for id in $IMAGE_IDS; do
        count="${COUNTS[$id]:-0}"
        [[ "$count" -gt 0 ]] && parts+=("$count (malachite-$id)")
    done
fi

IFS=', '
echo "${parts[*]}"
